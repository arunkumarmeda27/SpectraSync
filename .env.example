# SpectraSync Environment Configuration

# Application
PROJECT_NAME="SpectraSync"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api"
SECRET_KEY="spectrasync-super-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default uses local SQLite for seamless zero-setup testing, or PostgreSQL in Docker
DATABASE_URL="sqlite:///./spectrasync.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://spectrasync:spectrasync_pass@localhost:5432/spectrasync"

# Redis Queue
# If REDIS_URL is empty or unreachable, in-memory async worker queue is utilized
REDIS_URL="redis://localhost:6379/0"
USE_IN_MEMORY_QUEUE=true

# Storage (Local Filesystem fallback or MinIO / S3)
STORAGE_BACKEND="local" # "local" or "minio" or "s3"
LOCAL_STORAGE_DIR="./data/storage"
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET_NAME="spectrasync-artifacts"
MINIO_SECURE=false

# Processing Defaults
DEFAULT_MAX_SAMPLES=1048576 # 1M samples chunk limit
DEFAULT_DECIMATION=1
ENABLE_ML_CLASSIFIER=true
